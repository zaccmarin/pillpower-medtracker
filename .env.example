# Optional: the app has local-development defaults for these settings.
DJANGO_SECRET_KEY=replace-with-a-long-random-value
# Required only for the NHS medicine search.
NHS_API_KEY=replace-with-your-sandbox-api-key

# PostgreSQL connection used by the application.
DB_NAME=pillpower
DB_USER=postgres
DB_PASSWORD=replace-me
DB_HOST=localhost
DB_PORT=5432
